{
  "name": "@wion-pilot/sprout",
  "private": true,
  "description": "Sprout: a fictional plant-care app. It is the demo app that Wion-Pilot tests.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/web",
    "start": "node src/server/main.ts",
    "build": "vite build",
    "demo": "npm run build && npm run start",
    "reset": "node scripts/reset.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.8"
  }
}
