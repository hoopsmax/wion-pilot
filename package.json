{
  "name": "wion-pilot",
  "private": true,
  "description": "AI-assisted test automation platform for web apps, built with TypeScript and Playwright.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test": "bddgen && playwright test --pass-with-no-tests",
    "demo": "npm run demo -w @wion-pilot/sprout",
    "demo:reset": "npm run reset -w @wion-pilot/sprout"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "playwright-bdd": "9.2.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
