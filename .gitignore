node_modules/

# Keys come from environment variables and must never be committed.
.env
.env.*
!.env.example

# Runtime output (app map, AI proposals, ledger) is rebuilt on every run.
.wion/

# Test output is regenerated on every run.
.features-gen/
test-results/
playwright-report/
# The GitHub Pages site, put together by CI from site/, the GIF and the report.
_site/
blob-report/
coverage/

*.log
.DS_Store

# Sprout's live data: made from data/seed.json on the first run.
apps/sprout/data/db.json

# Sprout's built web app: made by npm run build.
apps/sprout/dist/

# Bug-report drafts: written by the test run for failing tests.
reports/
